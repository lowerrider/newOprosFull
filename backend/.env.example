# production включает проверку, что секреты заменены
NODE_ENV=development
# Порт API
PORT=3000
# На сервере: 127.0.0.1, чтобы бекенд был виден только через nginx
HOST=0.0.0.0
# Путь к файлу базы SQLite
DB_PATH=./data/opros.db
# Секрет для подписи токенов: длинная случайная строка (например, `openssl rand -hex 32`)
JWT_SECRET=change-me
# Вход в админку
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Откуда разрешены запросы (адрес клиента). Несколько через запятую.
CORS_ORIGIN=http://localhost:5173,https://lowerrider.github.io
# Ссылка на голосование, которая уйдёт в письме
APP_URL=https://lowerrider.github.io/Opros/
# Почта для рассылки паролей (те же настройки, что в omega-web)
SMTP_HOST=mail.mega-personal.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@mega-personal.ru
SMTP_FROM=no-reply@mega-personal.ru
SMTP_PASS=Gfhjkm@45
