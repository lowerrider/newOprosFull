# Скопируйте в /opt/opros/backend/.env и замените значения CHANGE_ME.
# Этот файл можно хранить в Git: настоящих секретов в нём быть не должно.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/opros.db

JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ADMIN_EMAIL=admin@mega-personal.ru
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD
REGULAR_ADMIN_EMAIL=manager@mega-personal.ru
REGULAR_ADMIN_PASSWORD=CHANGE_ME_USE_ANOTHER_LONG_PASSWORD

CORS_ORIGIN=https://www.mega-vote.ru,https://mega-vote.ru
APP_URL=https://www.mega-vote.ru/

SMTP_HOST=mail.mega-personal.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@mega-personal.ru
SMTP_FROM=no-reply@mega-personal.ru
SMTP_PASS=
